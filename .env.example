# Copy to .env.local and fill these from Supabase Project Settings > API.
# Use the project URL and publishable key (or legacy anon key). Never put a
# service-role or secret key in this file or in browser/client code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
